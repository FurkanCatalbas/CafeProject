# Required by music-service. Replace with real Spotify values if you use music voting.
SPOTIFY_CLIENT_ID=78d56f3325164f5c9f726b9a82e67176
SPOTIFY_CLIENT_SECRET=e40045c01d0f415a8c958e3d19a5ed3d
SPOTIFY_REDIRECT_URI=http://127.0.0.1:10101/music-service/api/music-votes/spotify/callback
MUSIC_VOTE_PUBLIC_URL_TEMPLATE=http://127.0.0.1:3000/music-vote/%s
MUSIC_VOTE_GATEWAY_BASE_URL=http://127.0.0.1:10101

# Supabase shared pooler has a low session limit; keep each Spring service pool small.
DB_MAX_POOL_SIZE=1
DB_MIN_IDLE=0
