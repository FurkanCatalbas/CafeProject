# Copy this file to backend/supabase.env and fill in your Supabase values.
# Do not commit backend/supabase.env.

# Supabase JDBC URL examples:
# Direct connection:
# jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require&currentSchema=public
# Session pooler:
# jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&currentSchema=public
# Transaction pooler:
# jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&currentSchema=public

SUPABASE_DB_URL=jdbc:postgresql://aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require&currentSchema=public
SUPABASE_DB_USERNAME=postgres.onofduxsqbsrkxzkaqeg
SUPABASE_DB_PASSWORD=1wK38h1BET8lwk9a

AUTH_DB_URL=${SUPABASE_DB_URL}
AUTH_DB_USERNAME=${SUPABASE_DB_USERNAME}
AUTH_DB_PASSWORD=${SUPABASE_DB_PASSWORD}
AUTH_DB_DRIVER=org.postgresql.Driver
AUTH_DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

USER_DB_URL=${SUPABASE_DB_URL}
USER_DB_USERNAME=${SUPABASE_DB_USERNAME}
USER_DB_PASSWORD=${SUPABASE_DB_PASSWORD}
USER_DB_DRIVER=org.postgresql.Driver
USER_DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

PLACE_DB_URL=${SUPABASE_DB_URL}
PLACE_DB_USERNAME=${SUPABASE_DB_USERNAME}
PLACE_DB_PASSWORD=${SUPABASE_DB_PASSWORD}
PLACE_DB_DRIVER=org.postgresql.Driver
PLACE_DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

PRODUCT_DB_URL=${SUPABASE_DB_URL}
PRODUCT_DB_USERNAME=${SUPABASE_DB_USERNAME}
PRODUCT_DB_PASSWORD=${SUPABASE_DB_PASSWORD}
PRODUCT_DB_DRIVER=org.postgresql.Driver
PRODUCT_DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

ORDER_DB_URL=${SUPABASE_DB_URL}
ORDER_DB_USERNAME=${SUPABASE_DB_USERNAME}
ORDER_DB_PASSWORD=${SUPABASE_DB_PASSWORD}
ORDER_DB_DRIVER=org.postgresql.Driver
ORDER_DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

MUSIC_VOTE_DB_URL=${SUPABASE_DB_URL}
MUSIC_VOTE_DB_USERNAME=${SUPABASE_DB_USERNAME}
MUSIC_VOTE_DB_PASSWORD=${SUPABASE_DB_PASSWORD}
MUSIC_VOTE_DB_DRIVER=org.postgresql.Driver
